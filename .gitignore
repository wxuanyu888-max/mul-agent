# Logs
*.log

# ===== STORAGE - Runtime data =====
# These are agent memory and conversation data - DO NOT COMMIT

# Memory files (short-term and long-term) - auto-generated
storage/memory/short_term/*/*.md
storage/memory/short_term/*/*.json
storage/memory/long_term/*/*.json

# Handover memory
storage/memory/handover/*.md
storage/memory/handover/*.json

# Conversation history
storage/conversations/*/

# Logs
storage/logs/*.log
storage/logs/*.jsonl

# Network queue (runtime data)
storage/network/queue/

# ===== WANG - Claude Code Config =====
# Runtime data (auto-generated)

# Token usage statistics
wang/token_usage/*.json

# Agent runtime data
wang/agent-team/core_brain/*.json
wang/agent-team/wangyue/*.json

# Frontend test results
frontend/test-results/
frontend/playwright-report/

# Frontend build
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/src/components/logs/
frontend/*.tsbuildinfo
frontend/*.js
frontend/*.d.ts
!frontend/postcss.config.js
!frontend/tailwind.config.js

# Python test coverage
htmlcov/
.coverage

# Scripts (runtime data)
scripts/*.pyc
scripts/__pycache__/
